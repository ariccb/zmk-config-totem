menu "Adaptive Key Options"

config ZMK_ADAPTIVE_KEY_MAX_TRIGGER_CONDITIONS
    int "Maximum number of adaptive key triggers"
    default 32

config ZMK_ADAPTIVE_KEY_MAX_BINDINGS
    int "Maximum number of trigger bindings"
    default 4

config ZMK_ADAPTIVE_KEY_WAIT_MS
    int "Time to wait between key presses when binding multiple behaviors"
    default 5

config ZMK_ADAPTIVE_KEY_TAP_MS
    int "Time to hold key presses when binding multiple behaviors"
    default 5

#Adaptive key options
endmenu

DT_COMPAT_ZMK_BEHAVIOR_ADAPTIVE_KEY := zmk,behavior-adaptive-key

config ZMK_BEHAVIOR_ADAPTIVE_KEY
    bool
    default $(dt_compat_enabled,$(DT_COMPAT_ZMK_BEHAVIOR_ADAPTIVE_KEY))

DT_COMPAT_ZMK_BEHAVIOR_OS_MODE := zmk,behavior-os-mode

config ZMK_BEHAVIOR_OS_MODE
    bool
    default $(dt_compat_enabled,$(DT_COMPAT_ZMK_BEHAVIOR_OS_MODE))

config TOTEM_OS_MODE_DEFAULT_WINDOWS
    bool "Boot into Windows shortcut mode before a Mac or Windows key is saved"
    depends on ZMK_BEHAVIOR_OS_MODE
    default n
    help
      Mac is the default. Pressing the Mac or Windows key on the System
      layer stores the choice. That saved choice is used on later boots
      and overrides this setting. Set this to y to make a fresh keyboard
      start in Windows mode.
